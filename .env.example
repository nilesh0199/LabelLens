# ==============================================================================
# LabelLens: Environment Variables Template
# Copy this file to .env.local and populate with your project credentials:
# cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (PostgreSQL Database & Storage)
# Obtain from: https://app.supabase.com/ > Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Google AI Studio / Gemini LLM
# Powers Gemini 2.0 Flash for multi-angle OCR synthesis & statutory field extraction
# Obtain from: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key

# ------------------------------------------------------------------------------
# Google Cloud Vision API
# Micro-print and package text detection (DOCUMENT_TEXT_DETECTION)
# Obtain from: https://console.cloud.google.com/ > APIs & Services > Credentials
# ------------------------------------------------------------------------------
GOOGLE_VISION_API_KEY=your-google-cloud-vision-api-key

# ------------------------------------------------------------------------------
# Feature Flags
# Set to 'true' to use Cloud Vision OCR, or 'false' for direct multimodal processing
# ------------------------------------------------------------------------------
USE_VISION_API=true
